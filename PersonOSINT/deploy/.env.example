# Hostname, unter dem das Team EagleEye aufruft (z. B. eagleeye.buero.local oder recherche.example.de)
EAGLEEYE_DOMAIN=eagleeye.buero.local
# "internal" (eigenes Zertifikat im Büronetz) oder eine E-Mail-Adresse für Let's Encrypt
EAGLEEYE_TLS=internal
# Tägliche Sicherung um diese Stunde (0–23), Anzahl aufbewahrter Sicherungen, Ablageort auf dem Host
EAGLEEYE_BACKUP_HOUR=2
EAGLEEYE_BACKUP_KEEP=14
EAGLEEYE_BACKUP_PATH=./backups
# Passphrase für Sicherungen (empfohlen, getrennt vom Server aufbewahren!). Leer = Anwendungsschlüssel.
EAGLEEYE_BACKUP_PASSPHRASE=
# Automatische Abmeldung nach Inaktivität (Minuten)
EAGLEEYE_SESSION_IDLE_MINUTES=120
# PDF/A-Export der Dossiers (LibreOffice im Image, ca. 400 MB). 0 = nur Word-Export
EAGLEEYE_WITH_PDF=1
